{
    "version": 2,
    "framework": null,
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3"
        }
    },
    "routes": [
        {
            "src": "/(css|js|images|img|fonts|build|certificates)/(.*)",
            "dest": "/$1/$2"
        },
        {
            "src": "/(.*\\.(?:ico|png|jpg|jpeg|svg|webp|gif|woff2?|ttf|map))",
            "dest": "/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
